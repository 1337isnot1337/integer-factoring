+  obtain ⟨χ, h1, h2⟩ := exists_good_five_sixth hK N.cc N.cc_self N.cc_symm P hfit hg
+  refine ⟨χ, fun γ => ?_, fun γ γ' hne => ?_, fun L hL => Net.value_group N χ L hL⟩
