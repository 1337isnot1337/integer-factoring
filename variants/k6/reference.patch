+    (c : Fin g → Fin g → ℕ) (hdiag : ∀ a, c a a = 0)
+    (hsym : ∀ a b, c a b = c b a) (P : ℕ)
+    (hrow : ∀ a, ∑ b, c a b ≤ P) (hg : K ^ 2 + 4 * K ^ 6 < g) :
+    ∃ χ : Fin g → Fin K, Good c P χ := by
+  have hsize : K ^ 2 + 4 * K ^ 2 * K ^ 4 < g := by
+    calc K ^ 2 + 4 * K ^ 2 * K ^ 4 = K ^ 2 + 4 * K ^ 6 := by ring
+      _ < g := hg
